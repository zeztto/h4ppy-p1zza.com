NODE_ENV=development
PORT=3001
# Public Git revision recorded in the production image label.
APP_REVISION=local
# Default for `npm run dev`; production Docker Compose is served through Caddy.
APP_ORIGIN=http://localhost:5173
CANONICAL_REDIRECT_HOSTS=www.p1zza.kr
# Public site key: required at Docker build time and also provided at runtime.
# TURNSTILE_SECRET_KEY stays runtime-only and must never become a build arg.
VITE_TURNSTILE_SITE_KEY=replace-me

GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=rotate-and-replace
ADMIN_GITHUB_LOGINS=zeztto
SESSION_SECRET=generate-a-new-random-secret

# App role: CRUD only; no schema CREATE, ownership, or privileged role membership.
DATABASE_URL=postgres://p1zza_app:generate-a-new-password@db:5432/p1zza
# Privileged schema-only bootstrap, never passed into the app service.
MIGRATION_DATABASE_URL=postgres://postgres:generate-a-different-password@db:5432/p1zza
POSTGRES_DB=p1zza
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate-a-different-password
# Loopback template only. Production requires Caddy's exact network IPv4 /32.
# Resolve it on p1zza-2nd and store the actual address only in private env.
TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Legacy migration source only.
TURSO_DATABASE_URL=libsql://replace-me.turso.io
TURSO_AUTH_TOKEN=replace-me

# Use either CLOUDINARY_URL or the split variables below.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

TURNSTILE_SECRET_KEY=replace-me
